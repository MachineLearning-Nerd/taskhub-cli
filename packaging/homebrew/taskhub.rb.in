# Homebrew formula template for the taskhub CLI. scripts/render-packaging.sh fills in @VERSION@ and the
# @SHA256_<TARGET>@ checksums from a release's .sha256 files; the result goes into the owner's tap.
class Taskhub < Formula
  desc "Command-line client and MCP server for TaskHub"
  homepage "@REPOSITORY@"
  license "MIT"

  on_macos do
    on_arm do
      url "@REPOSITORY@/releases/download/v@VERSION@/taskhub-cli-aarch64-apple-darwin.tar.xz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "@REPOSITORY@/releases/download/v@VERSION@/taskhub-cli-x86_64-apple-darwin.tar.xz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "@REPOSITORY@/releases/download/v@VERSION@/taskhub-cli-aarch64-unknown-linux-musl.tar.xz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "@REPOSITORY@/releases/download/v@VERSION@/taskhub-cli-x86_64-unknown-linux-musl.tar.xz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "taskhub"
    man1.install "taskhub.1"
    bash_completion.install "completions/taskhub.bash" => "taskhub"
    zsh_completion.install "completions/_taskhub"
    fish_completion.install "completions/taskhub.fish"
  end

  test do
    assert_match "taskhub #{version}", shell_output("#{bin}/taskhub --version")
    assert_match "\"cli\":\"#{version}\"", shell_output("#{bin}/taskhub version --json")
  end
end
