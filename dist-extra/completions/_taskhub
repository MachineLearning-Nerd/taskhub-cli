(( $+functions[_taskhub_commands] )) ||
_taskhub_commands() {
    local commands; commands=(
'next:Find the next item to work on\: sent-back work first, then assigned, then unassigned' \
'claim:Assign an item to yourself and move it from To Do to In Progress' \
'show:Show an item with its project, allowed moves, latest comments, files and links' \
'mine:Your To Do and In Progress items' \
'comment:Add a Markdown comment; @username notifies' \
'submit:Submit work for review\: evidence comment, links and the move to Dev Done in one step' \
'reject:Send an item in Dev Done back to In Progress with a reason (Testers)' \
'inbox:Inbox entries for your projects. Reading never marks them read' \
'link:Add a link to an item; adding the same URL again is harmless' \
'branch:Print a branch name for an item, or switch to it with --create' \
'open:Open the item in the browser (prints the URL when not on a terminal)' \
'items:List, read, create, edit and move items' \
'comments:List and edit comments' \
'attachments:List, upload and download files' \
'projects:List projects and show their labels, members and limits' \
'pending:Writes whose outcome is unknown' \
'retry:Resend a pending write exactly, with its original request ID' \
'auth:Log in with an API token, check the login, or log out' \
'guide:A one-page guide for agents' \
'skill:Install the TaskHub agent skill for Claude Code or Codex' \
'mcp:Serve TaskHub tools over MCP on stdin and stdout' \
'completions:Print shell completions' \
'version:Print the CLI, contract and API versions. Works offline' \
'man:Write the man page to stdout (for packaging)' \
    )
    _describe -t commands 'taskhub commands' commands "$@"
}
